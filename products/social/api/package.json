{
  "name": "@ap/social-api",
  "version": "0.0.0",
  "private": true,
  "description": "Social product API: posts, approvals, scheduling. Publishes through integrations-api.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "nx": {
    "tags": [
      "scope:social",
      "type:service"
    ]
  },
  "dependencies": {
    "@ap/service-kit": "workspace:*",
    "@ap/social-domain": "workspace:*",
    "@ap/tenant": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ap/config": "workspace:*",
    "jose": "^6.2.12"
  }
}
