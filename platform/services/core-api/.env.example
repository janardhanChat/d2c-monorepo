PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Supabase (self-hosted) - prefer JWKS; the shared secret is the legacy fallback
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_ISSUER=

# Leave empty to run with the in-memory repository (local dev / tests)
DATABASE_URL=
