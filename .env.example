# Shared env for infra/compose (each service also has its own .env.example for local dev)
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8080

# Supabase (self-hosted)
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgres://postgres:postgres@supabase-db:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-to-service
INTERNAL_SERVICE_TOKEN=

# Postiz (internal network)
POSTIZ_URL=http://postiz:5000/api/public/v1
POSTIZ_API_KEY=

# AI
LLM_PROVIDER=echo
LLM_API_KEY=
