{
  "name": "@ap/web",
  "version": "0.0.0",
  "private": true,
  "description": "D2C Business OS dashboard: auth, onboarding, org/brand shell, product modules, automations",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "nx": {
    "tags": [
      "scope:shell",
      "type:app"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.next"
        ]
      }
    }
  },
  "dependencies": {
    "@ap/commerce-frontend": "workspace:*",
    "@ap/crm-frontend": "workspace:*",
    "@ap/fulfillment-frontend": "workspace:*",
    "@ap/platform-frontend": "workspace:*",
    "@ap/product-kit": "workspace:*",
    "@ap/social-domain": "workspace:*",
    "@ap/social-frontend": "workspace:*",
    "@ap/ui": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ap/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
