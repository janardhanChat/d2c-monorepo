{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm exec nx *)",
      "Bash(pnpm nx *)",
      "Bash(pnpm format)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm affected)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(node --test *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm --filter *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(git commit *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./**/uv.lock)",
      "Edit(./eslint.config.mjs)",
      "Edit(./nx.json)",
      "Edit(./.husky/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./tools/agents/**)",
      "Edit(./**/AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pip install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agents/guard-edit.mjs"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agents/guard-bash.mjs"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agents/format-edited.mjs"]
          }
        ]
      }
    ]
  }
}
