{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/packages/config/tsconfig/*.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.{spec,test}.{ts,tsx}",
      "!{projectRoot}/**/*.stories.{ts,tsx}",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/tests/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "build-storybook": {
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/storybook-static"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "continuous": true
    }
  },
  "parallel": 4,
  "tui": { "enabled": false }
}
